#!/bin/bash
set -o pipefail

# The RAW backlog can take a day over the USA->EU link. Re-exec under caffeinate
# (same pattern as push_photos_to_nas) so idle sleep doesn't stall the upload:
# -i blocks idle sleep (on battery too), -s system sleep on AC, -d display
# sleep. Closing the lid still sleeps.
if [ -z "$BACKUP_PHOTOS_CAFFEINATED" ]; then
    export BACKUP_PHOTOS_CAFFEINATED=1
    exec caffeinate -dis "$0" "$@"
fi

# One Ctrl-C ends the whole run. Without this, the terminal's SIGINT only kills
# the restic in flight (which still removes its own lock) and the script then
# carries on with check/forget/metrics. bash runs the trap once that child exits.
trap 'echo "!!! interrupted -- aborting backup_photos" >&2; exit 130' INT TERM

# --- CONFIGURATION ---
# restic's rclone backend (`rclone serve restic --stdio`) on top of an rclone
# *sftp* remote to pcloud's SFTP endpoint -- not rclone's pcloud (HTTP API)
# backend, whose upload endpoint accepted truncated packs (2026-08-13, -29).
# restic's own sftp backend can't reconnect after pcloud drops the ssh session,
# and treats pcloud's "file does not exist" right after a rename as permanent;
# either one aborts the whole backup. rclone keeps a connection pool, retries
# each failed operation, and hands anything left to restic as a retryable
# HTTP 500. Same repos/files as the sftp:pcloud-sftp:... URLs used by
# restic-verify-data on pouchmaster.
REPO_BASE="rclone:pcloudsftp:/Backups/Macbook_Photos/backup"
REPO_CAT="$REPO_BASE/restic_catalog"
REPO_RAW="$REPO_BASE/restic_photos"

# Restic repo password.
export RESTIC_PASSWORD_COMMAND="keyring_helper restic_photos"

# SSH auth for the sftp backend. pcloud's endpoint is password-only and OpenSSH
# has no ssh_config password directive, so ssh pulls the pCloud account password
# from `keyring_helper pcloud` via bin/pcloud-sftp-askpass. SSH_ASKPASS_REQUIRE=
# force (OpenSSH >= 8.4) uses it even with a tty; DISPLAY satisfies older builds.
# The `pcloud-sftp` Host alias (HostName esftp.pcloud.com, User the account
# e-mail) must exist in ~/.ssh/config with its key in ~/.ssh/known_hosts.
export SSH_ASKPASS="$(CDPATH= cd "$(dirname "$0")" && pwd)/pcloud-sftp-askpass"
export SSH_ASKPASS_REQUIRE=force
export DISPLAY="${DISPLAY:-:0}"

# The `pcloudsftp` rclone remote, defined here instead of in rclone.conf so it's
# versioned with this script. `ssh = ssh ... pcloud-sftp` makes rclone run
# OpenSSH per connection, reusing the Host alias + askpass above (no password
# stored for rclone). ServerAlive*: a connection that died silently (sleep/wake,
# a NAT timeout) otherwise stays ESTABLISHED with its request never answered,
# and once every pooled connection is stuck like that the backup hangs forever
# at 0 B/s (2026-09-27). With keepalives ssh exits within ~60s, rclone sees
# "connection lost", and reconnects. pcloud's SFTP has no shell, so no remote hashing; set_modtime
# off skips the post-upload setstat -- another call that can hit pcloud's
# visibility lag.
export RCLONE_CONFIG_PCLOUDSFTP_TYPE=sftp
export RCLONE_CONFIG_PCLOUDSFTP_SSH="ssh -o ServerAliveInterval=15 -o ServerAliveCountMax=4 pcloud-sftp"
export RCLONE_CONFIG_PCLOUDSFTP_SET_MODTIME=false
export RCLONE_CONFIG_PCLOUDSFTP_SHELL_TYPE=none
export RCLONE_CONFIG_PCLOUDSFTP_MD5SUM_COMMAND=none
export RCLONE_CONFIG_PCLOUDSFTP_SHA1SUM_COMMAND=none
export RCLONE_CONFIG_PCLOUDSFTP_KNOWN_HOSTS_FILE="$HOME/.ssh/known_hosts"

# --- ARGS ---
# --verify-data / -V: also run the slow deep pack-*content* check
# (restic-verify-data, ~2h/pass over pcloud). Off by default -- the everyday run
# only does the fast size/structure check. Prefer running the deep check from
# cron on a server; see bin/restic-verify-data.
DO_VERIFY=0
while [ $# -gt 0 ]; do
    case "$1" in
        -V|--verify-data) DO_VERIFY=1 ;;
        -h|--help) echo "usage: $(basename "$0") [--verify-data]"; exit 0 ;;
        *) echo "$(basename "$0"): unknown argument '$1'" >&2
           echo "usage: $(basename "$0") [--verify-data]" >&2
           exit 2 ;;
    esac
    shift
done

# Interactive run? Let restic emit a periodic progress line (~every 20s) -- it
# still flows through `tee` into the log. `-t 0` (a terminal on stdin) survives
# the `... | tee` pipe on each backup call, so it's the reliable signal. Cron
# leaves this unset, so restic prints only its end-of-run summary as before.
if [ -t 0 ] || [ -t 1 ] || [ -t 2 ]; then
    export RESTIC_PROGRESS_FPS="${RESTIC_PROGRESS_FPS:-0.05}"
fi

# --- pre-flight: is the metrics host reachable? ---
# backup_photos pushes run status to VictoriaMetrics (restic-metrics-push). If
# it's unreachable -- offline, or the gate rejects `keyring_helper vicmetrics`
# -- the backup still runs but Grafana won't see this run (the staleness alert
# will fire). Warn; interactively,
# ask first (declining this top-level check just aborts -- unlike
# restic-verify-data's own preflight, there's no caller here that needs to
# distinguish "skipped" from "failed"). Cron (no TTY) warns and proceeds.
# RESTIC_METRICS_ASSUME_YES=1 skips the prompt.
. "$(dirname "$0")/restic-common.sh"
metrics_preflight "backup" || exit 1

# Transport note: this still runs from the laptop over the congested USA->EU
# link. How rclone's sftp backend handles a transfer cut off mid-write on pcloud
# is unproven, so check_and_heal() below stays as the safety net against a
# short pack, and restic_backup_retry() as the fallback if a transient error
# still aborts a backup.

EXCLUDE_FILE="$(dirname "$0")/restic-excludes.txt"

# pcloud's listing lags behind deletes: a lock the previous restic command
# removed can show up again for a minute or two, and the next command then
# fails with "repository is already locked" (2026-09-27, catalog forget). Wait
# it out instead of failing.
RETRY_LOCK=(--retry-lock 5m)

LOG_DIR="$HOME/Library/Logs/restic"
mkdir -p "$LOG_DIR"
TS="$(date +%Y%m%d-%H%M%S)"

# restic_backup_retry <log> <label> <repo> <backup args...>
#
# Runs `restic -r <repo> backup <args>`, appending to <log>. Retries (up to
# RESTIC_BACKUP_ATTEMPTS, default 5) only when pCloud's sftp aborted the backup
# after it was already running. A config/auth failure is not retried.
#  - Visibility lag: restic's sftp Save() writes a temp pack, renames it into
#    place, then chmods it read-only. pcloud sometimes hasn't made the file
#    visible yet for the next step, so the rename (2026-09-27) or the chmod
#    (2026-09-25, -26) fails with "file does not exist". restic counts
#    not-exist as permanent and aborts the whole backup.
#  - Dropped connection: pcloud closes the ssh session ("closed by remote host",
#    2026-09-25, -27). restic's sftp backend can't reconnect, so every
#    later call fails with "ssh command exited". Before this retry the helper
#    waits RESTIC_RETRY_PAUSE seconds (default 30).
# The repo is fine either way. Packs from the aborted run (or their
# -restic-temp- files) just aren't indexed, and `restic check` reports them as
# "not referenced in any index". A manual `restic prune` clears those. A retry
# rescans quickly because of the parent snapshot, and keeps progress: restic
# writes an index during the backup every 10 min, so only the data from the
# last ~10 min before the failure is uploaded again. The dead run's lock is
# left behind, so `unlock` runs first (restic treats a lock whose PID is gone on
# this host as stale). Every attempt stays in <log>, so the Fatal line still
# marks the run as degraded for metrics. Returns the last attempt's exit code.
restic_backup_retry() {
    local log="$1" label="$2" repo="$3"
    shift 3
    local max="${RESTIC_BACKUP_ATTEMPTS:-5}" n=1 rc attempt_log
    attempt_log="$(mktemp -t restic-attempt)"
    while :; do
        : > "$attempt_log"
        restic -r "$repo" backup "${RETRY_LOCK[@]}" "$@" 2>&1 | tee -a "$log" "$attempt_log"
        rc=$?
        [ "$rc" -eq 0 ] || [ "$n" -ge "$max" ] && break
        n=$((n + 1))
        if grep -qE '^Fatal: unable to save snapshot: .*: file does not exist' "$attempt_log"; then
            echo "!!! ${label}: pCloud not-exist race (attempt ${n}/${max}) -- retrying" | tee -a "$log"
        elif grep -qE '^Fatal: unable to save snapshot: .*ssh command exited' "$attempt_log"; then
            echo "!!! ${label}: pCloud dropped the connection (attempt ${n}/${max}) -- retrying in ${RESTIC_RETRY_PAUSE:-30}s" | tee -a "$log"
            sleep "${RESTIC_RETRY_PAUSE:-30}"
        else
            break
        fi
        restic -r "$repo" unlock 2>/dev/null
    done
    rm -f "$attempt_log"
    return "$rc"
}

# check_and_heal <config> <repo> <src> <check_log> [heal-backup-opts...]
#
# Runs `restic check` and tees it to <check_log>. If the check reports damaged
# pack files (a truncated pack from a dropped transfer on the spotty link),
# attempts a *lossless* in-place heal while the source is still attached: repair
# index (drops the broken packs from the index) followed by a re-`backup`
# (re-uploads the now-missing blobs from <src>), then re-checks. Never runs
# `repair snapshots --forget` or `prune` -- those lose data and are left for
# manual review.
#
# Sets global REPO_DAMAGED=1 if truncation was seen (whether or not the heal
# cleared it). Returns the final check's exit code (non-zero if anything is
# still wrong).
check_and_heal() {
    local cfg="$1" repo="$2" src="$3" check_log="$4"
    shift 4
    local heal_opts=("$@")
    local rc

    # A backup that died on a dropped connection leaves its lock behind (it
    # couldn't reach pcloud to remove it), and check's exclusive lock would
    # fail on it. unlock only removes stale locks, like one whose PID is gone.
    restic -r "$repo" unlock 2>/dev/null
    restic -r "$repo" check "${RETRY_LOCK[@]}" --verbose 2>&1 | tee "$check_log"
    rc=$?

    grep -qiE "$RESTIC_DAMAGED_PATTERN" "$check_log" || return "$rc"

    REPO_DAMAGED=1
    echo "!!! ${cfg}: damaged pack files detected -- attempting lossless in-place heal"
    restic -r "$repo" unlock 2>&1 | tee "$LOG_DIR/${cfg}-autorepair-unlock-$TS.log"
    restic -r "$repo" repair index "${RETRY_LOCK[@]}" --verbose 2>&1 | tee "$LOG_DIR/${cfg}-autorepair-index-$TS.log"

    if [ -e "$src" ]; then
        restic_backup_retry "$LOG_DIR/${cfg}-autorepair-heal-$TS.log" "$cfg" \
            "$repo" "$src" --verbose \
            --exclude-file="$EXCLUDE_FILE" "${heal_opts[@]}"
    else
        echo "!!! ${cfg}: source '$src' unavailable -- cannot heal, manual repair needed"
    fi

    local recheck_log="$LOG_DIR/${cfg}-autorepair-check-$TS.log"
    restic -r "$repo" check "${RETRY_LOCK[@]}" --verbose 2>&1 | tee "$recheck_log"
    rc=$?
    if [ "$rc" -eq 0 ] && ! grep -qiE "$RESTIC_DAMAGED_PATTERN" "$recheck_log"; then
        echo ">>> ${cfg}: auto-heal succeeded"
    else
        echo "!!! ${cfg}: auto-heal did NOT clear all errors -- manual intervention required"
        rc=1
    fi
    return "$rc"
}

# --- 1. BACK UP CATALOG ---
echo "--- [1/2] Backing up Lightroom catalog ---"
if [ -d "$HOME/Pictures/Lightroom" ]; then
    CAT_LOG="$LOG_DIR/catalog-backup-$TS.log"
    restic -r "$REPO_CAT" unlock 2>/dev/null
    # -o rclone.connections=8: the catalog is many small files, so extra parallel
    # ssh channels help (default is 5). RAWs below stay at the default.
    restic_backup_retry "$CAT_LOG" catalog "$REPO_CAT" "$HOME/Pictures/Lightroom" \
        --verbose \
        -o rclone.connections=8 \
        --exclude-file="$EXCLUDE_FILE" \
        --compression max
    CAT_RC=$?

    # rc=0 but restic logged a non-fatal error line, or restic_backup_retry had
    # to rerun the backup after a Fatal -- still counts as a degraded run for
    # the metrics event. Retried-then-succeeded requests ("returned error,
    # retrying") don't: over rclone they're routine on pcloud and would mark
    # nearly every run. Anchored so a filename containing "error" in --verbose
    # output doesn't trip it.
    CAT_DEGRADED=0
    grep -qE '^(error|Fatal):' "$CAT_LOG" && CAT_DEGRADED=1

    REPO_DAMAGED=0
    check_and_heal catalog "$REPO_CAT" "$HOME/Pictures/Lightroom" \
        "$LOG_DIR/catalog-check-$TS.log" --compression max
    CAT_CHECK_RC=$?
    CAT_DAMAGED=$REPO_DAMAGED

    if [ "$DO_VERIFY" -eq 1 ]; then
        "$(dirname "$0")/restic-verify-data" catalog "$REPO_CAT"
        CAT_SUBSET_RC=$?
        # exit 3 = metrics preflight declined, not a verification failure --
        # note it but don't block forget over an unrelated metrics outage. Any
        # other non-zero (1 = ran and failed/damaged; 2 = bad usage, shouldn't
        # happen here) is a real problem.
        if [ "$CAT_SUBSET_RC" -eq 3 ]; then
            echo "!!! catalog: deep verify skipped (metrics preflight declined) -- not treated as a failure" >&2
        elif [ "$CAT_SUBSET_RC" -ne 0 ]; then
            CAT_CHECK_RC=$CAT_SUBSET_RC
        fi
    fi

    # forget only runs on a successful backup whose repo also passed its
    # integrity check -- a failed run or a damaged repo must not be pruned,
    # so we keep every snapshot we might still need to recover from.
    if [ "$CAT_RC" -eq 0 ] && [ "$CAT_CHECK_RC" -eq 0 ]; then
        restic -r "$REPO_CAT" \
            forget "${RETRY_LOCK[@]}" --keep-last 3 --keep-within-hourly 12h --keep-within-daily 10d --keep-within-weekly 31d --keep-within-monthly 12m --keep-within-yearly 5y \
            --verbose \
            2>&1 | tee "$LOG_DIR/catalog-forget-$TS.log"
    fi

    CAT_EVENT="success"
    { [ "$CAT_RC" -ne 0 ] || [ "$CAT_DEGRADED" -eq 1 ]; } && CAT_EVENT="error"
    "$(dirname "$0")/restic-metrics-push" catalog "$CAT_EVENT" "$REPO_CAT"

    CAT_CHECK_EVENT="success"
    [ "$CAT_CHECK_RC" -ne 0 ] && CAT_CHECK_EVENT="error"
    [ "$CAT_DAMAGED" -eq 1 ] && CAT_CHECK_EVENT="damaged"
    "$(dirname "$0")/restic-metrics-push" catalog_check "$CAT_CHECK_EVENT" "$REPO_CAT"
else
    echo "ERROR: Catalog path not found!"
fi

echo ""

# --- 2. BACK UP PHOTOS ---
echo "--- [2/2] Backing up Sony RAWs ---"
PHOTO_MOUNT="/Volumes/Photos"

if [ -d "$PHOTO_MOUNT" ]; then
    echo "Drive detected. Starting RAW backup..."
    RAW_LOG="$LOG_DIR/photos-backup-$TS.log"
    restic -r "$REPO_RAW" unlock 2>/dev/null
    # Default 16 MiB packs. No --compression max: ARW files are already compressed.
    restic_backup_retry "$RAW_LOG" photos "$REPO_RAW" "$PHOTO_MOUNT" \
        --verbose \
        --exclude-file="$EXCLUDE_FILE"
    RAW_RC=$?

    RAW_DEGRADED=0
    grep -qE '^(error|Fatal):' "$RAW_LOG" && RAW_DEGRADED=1

    REPO_DAMAGED=0
    check_and_heal photos "$REPO_RAW" "$PHOTO_MOUNT" "$LOG_DIR/photos-check-$TS.log"
    RAW_CHECK_RC=$?
    RAW_DAMAGED=$REPO_DAMAGED

    if [ "$DO_VERIFY" -eq 1 ]; then
        "$(dirname "$0")/restic-verify-data" photos "$REPO_RAW"
        RAW_SUBSET_RC=$?
        # See the catalog block above for why exit 3 is handled separately.
        if [ "$RAW_SUBSET_RC" -eq 3 ]; then
            echo "!!! photos: deep verify skipped (metrics preflight declined) -- not treated as a failure" >&2
        elif [ "$RAW_SUBSET_RC" -ne 0 ]; then
            RAW_CHECK_RC=$RAW_SUBSET_RC
        fi
    fi

    # See the catalog block: forget needs both a clean backup and a clean check.
    if [ "$RAW_RC" -eq 0 ] && [ "$RAW_CHECK_RC" -eq 0 ]; then
        restic -r "$REPO_RAW" \
            forget "${RETRY_LOCK[@]}" --keep-last 3 --keep-within-hourly 12h --keep-within-daily 10d --keep-within-weekly 31d --keep-within-monthly 12m --keep-within-yearly 5y \
            --verbose \
            2>&1 | tee "$LOG_DIR/photos-forget-$TS.log"
    fi

    RAW_EVENT="success"
    { [ "$RAW_RC" -ne 0 ] || [ "$RAW_DEGRADED" -eq 1 ]; } && RAW_EVENT="error"
    "$(dirname "$0")/restic-metrics-push" photos "$RAW_EVENT" "$REPO_RAW"

    RAW_CHECK_EVENT="success"
    [ "$RAW_CHECK_RC" -ne 0 ] && RAW_CHECK_EVENT="error"
    [ "$RAW_DAMAGED" -eq 1 ] && RAW_CHECK_EVENT="damaged"
    "$(dirname "$0")/restic-metrics-push" photos_check "$RAW_CHECK_EVENT" "$REPO_RAW"
else
    echo "INFO: External drive ($PHOTO_MOUNT) not attached."
    echo "-> Skipping RAW backup today."
    # Deliberately no push here: drive-not-mounted is not a backup failure,
    # and the Grafana staleness panel already reflects an overdue "photos"
    # backup correctly without a false-positive error push.
fi

"$(dirname "$0")/restic-metrics-push" pcloud

echo "--- Backup run finished ---"
