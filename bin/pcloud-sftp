#!/bin/sh
# restic `sftp.command` wrapper for the pCloud native SFTP endpoint.
#
# restic's sftp backend runs this to open the SFTP subsystem; it speaks the
# SFTP protocol on stdin/stdout. We just exec ssh through the `pcloud-sftp`
# Host alias (defined in ~/.ssh/config -> esftp.pcloud.com, User the pCloud
# account e-mail -- the '@' in that user name is why an alias is required and
# the address can't go in the restic repo URL).
#
# pCloud's SFTP endpoint is password-only. ssh gets the password from
# bin/pcloud-sftp-askpass (which prints `keyring_helper pcloud`) via SSH_ASKPASS.
# SSH_ASKPASS_REQUIRE=force makes ssh use it even when a tty is present
# (OpenSSH >= 8.4); DISPLAY is set because some older builds still gate askpass
# on it. This keeps the whole mechanism inside the repo -- nothing to export in
# crontab.
#
# Usage (from restic): restic -o sftp.command="/path/to/bin/pcloud-sftp" ...
here="$(CDPATH= cd "$(dirname "$0")" && pwd)"
export SSH_ASKPASS="$here/pcloud-sftp-askpass"
export SSH_ASKPASS_REQUIRE=force
export DISPLAY="${DISPLAY:-:0}"
exec ssh pcloud-sftp -s sftp "$@"
