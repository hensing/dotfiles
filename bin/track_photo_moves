#!/usr/bin/env python3
"""
Track file moves/renames on the photos drive so a sorting session doesn't
force a full re-upload of files that just changed location.

A `mv`/rename on the same APFS volume preserves a file's inode number; only a
copy or delete+recreate changes it. So: snapshot (inode, relative path, size)
before sorting, snapshot again after, and diff by inode -- any inode present
in both with a changed relative path is an exact, unambiguous move (no
fuzzy name/size guessing needed, unlike rsync's --fuzzy). Replaying those as
`mv` commands on the NAS's mac/ mirror makes the move free (a rename) instead
of a full re-transfer over the network.

Usage:
  track_photo_moves snapshot [path]     # record current (inode, path, size) state
  track_photo_moves diff-apply [path]   # diff against the saved snapshot, print
                                         # detected moves, confirm, replay on the
                                         # NAS's mac/ mirror, then save the new
                                         # state as the baseline for next time

path defaults to /Volumes/Photos.
"""
import argparse
import shlex
import subprocess
import sys
import unicodedata
from pathlib import Path

DEFAULT_PATH = "/Volumes/Photos"
STATE_FILE = Path.home() / "Library" / "Caches" / "photo-mv-tracker.tsv"
REMOTE = "truenas"
REMOTE_MAC_DIR = "/mnt/storage/photos/mac"


def nfc(s):
    return unicodedata.normalize("NFC", s)


def local_listing(path):
    """inode -> (relpath(NFC), size) for files under path."""
    try:
        out = subprocess.run(
            ["find", path, "-type", "f", "-exec", "stat", "-f", "%i\t%z\t%N", "{}", "+"],
            capture_output=True, text=True, check=True, stdin=subprocess.DEVNULL,
        ).stdout
    except subprocess.CalledProcessError as e:
        print(f"!! listing failed for {path}: {e.stderr.strip()}", file=sys.stderr)
        sys.exit(1)
    prefix = path.rstrip("/") + "/"
    result = {}
    for line in out.splitlines():
        if not line.strip():
            continue
        inode, size, full = line.split("\t", 2)
        rel = full[len(prefix):] if full.startswith(prefix) else full
        result[inode] = (nfc(rel), int(size))
    return result


def save_snapshot(listing):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(STATE_FILE, "w", encoding="utf-8") as f:
        for inode, (rel, size) in listing.items():
            f.write(f"{inode}\t{size}\t{rel}\n")


def load_snapshot():
    if not STATE_FILE.exists():
        print(f"No snapshot found at {STATE_FILE}. Run 'snapshot' first, before you start sorting.", file=sys.stderr)
        sys.exit(1)
    result = {}
    with open(STATE_FILE, encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n")
            if not line:
                continue
            inode, size, rel = line.split("\t", 2)
            result[inode] = (rel, int(size))
    return result


def cmd_snapshot(path):
    listing = local_listing(path)
    save_snapshot(listing)
    print(f"Snapshot saved: {len(listing)} files under {path} -> {STATE_FILE}")


def cmd_diff_apply(path):
    old = load_snapshot()
    new = local_listing(path)

    moves = []
    reused = []
    for inode, (new_rel, new_size) in new.items():
        if inode in old:
            old_rel, old_size = old[inode]
            if old_rel != new_rel:
                # A `mv` never changes a file's byte content, so a genuine
                # rename always keeps the same size. If the size differs
                # despite the inode matching, APFS has reused a freed inode
                # for an unrelated new file -- treating this as a move would
                # replay a rename of the OLD (deleted) file's content onto
                # the NEW file's path on the NAS, silently corrupting the
                # mirror. Report it separately instead of acting on it.
                if old_size == new_size:
                    moves.append((old_rel, new_rel, new_size))
                else:
                    reused.append((old_rel, new_rel, old_size, new_size))

    only_old = set(old) - set(new)
    only_new = set(new) - set(old)

    print(f"{len(moves)} moves detected, {len(only_old)} files gone (deleted or moved off {path}), "
          f"{len(only_new)} genuinely new files (not moves).\n")

    if reused:
        print(f"!! {len(reused)} inode(s) matched but size changed -- treated as unrelated "
              f"files (likely inode reuse after a delete), NOT as moves:")
        for old_rel, new_rel, old_size, new_size in reused:
            print(f"    '{old_rel}' ({old_size}B) -> '{new_rel}' ({new_size}B) -- different content")
        print()

    if not moves:
        print("Nothing to replay on the NAS.")
        save_snapshot(new)
        print(f"Snapshot updated -> {STATE_FILE}")
        return

    print("--- detected moves ---")
    for old_rel, new_rel, size in moves:
        print(f"  '{old_rel}' -> '{new_rel}'  ({size} bytes)")

    print(f"\nAbout to replay these {len(moves)} moves on {REMOTE}:{REMOTE_MAC_DIR}/ (mv, cheap renames).")
    print("Moves where the old path isn't there yet (nothing pushed there) or the new path")
    print("already exists (avoid clobbering) are skipped -- the regular push handles those.")
    if input("Type 'yes' to apply: ").strip().lower() != "yes":
        print("Aborted -- NAS not touched. Snapshot NOT updated (re-run diff-apply when ready).")
        return

    # `cmd && echo ok || echo fail` always exits 0 (echo never fails), so a
    # per-item mv failure would otherwise be invisible to the ssh exit code
    # -- track failures explicitly in the remote shell and exit non-zero if
    # any happened, so this script can tell real failures apart from success
    # and avoid saving a snapshot that would silently drop the still-pending
    # move.
    script_lines = ["FAILCOUNT=0"]
    for old_rel, new_rel, _ in moves:
        src = f"{REMOTE_MAC_DIR}/{old_rel}"
        dst = f"{REMOTE_MAC_DIR}/{new_rel}"
        dst_parent = "/".join(dst.split("/")[:-1])
        script_lines.append(
            f"if [ -e {shlex.quote(dst)} ]; then echo 'SKIP (already at destination): {new_rel}'; "
            f"elif [ -e {shlex.quote(src)} ]; then "
            f"mkdir -p {shlex.quote(dst_parent)} && "
            f"mv -n {shlex.quote(src)} {shlex.quote(dst)} && echo 'moved: {old_rel} -> {new_rel}' "
            f"|| {{ echo 'FAILED to move: {old_rel} -> {new_rel}'; FAILCOUNT=$((FAILCOUNT+1)); }}; "
            f"else echo 'SKIP (not on NAS yet): {old_rel}'; fi"
        )
    script_lines.append('exit "$FAILCOUNT"')
    script = "\n".join(script_lines) + "\n"

    result = subprocess.run(["ssh", REMOTE, "bash", "-s"], input=script, text=True)
    if result.returncode != 0:
        print(f"\n!! {result.returncode} move(s) failed on the NAS -- check output above.", file=sys.stderr)
        print("Snapshot NOT updated, so the failed move(s) will show up again on the next diff-apply.", file=sys.stderr)
        return

    save_snapshot(new)
    print(f"\nSnapshot updated -> {STATE_FILE}")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("command", choices=["snapshot", "diff-apply"])
    ap.add_argument("path", nargs="?", default=DEFAULT_PATH)
    args = ap.parse_args()

    if args.command == "snapshot":
        cmd_snapshot(args.path)
    else:
        cmd_diff_apply(args.path)


if __name__ == "__main__":
    main()
