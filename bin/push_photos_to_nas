#!/bin/bash
set -o pipefail

# A full --checksum pass over a multi-TB library can run for hours. Re-exec
# under caffeinate so a laptop sleep cycle doesn't kill the run partway
# through -- a sleep/wake mid-transfer drops the SSH connection, and without
# keepalives (below) the rsync process can hang indefinitely without ever
# noticing the connection is gone (observed live: 4+ hours hung, 20s total
# CPU time, after a sleep/wake at 03:01).
if [ -z "$PHOTOS_PUSH_CAFFEINATED" ]; then
    export PHOTOS_PUSH_CAFFEINATED=1
    exec caffeinate -dis "$0" "$@"
fi

# --- CONFIGURATION ---
REMOTE_HOST="truenas"
PHOTO_MOUNT="/Volumes/Photos"
CATALOG_SRC="$HOME/Pictures/Lightroom"
REMOTE_MAC_DIR="/mnt/storage/photos/mac/"
REMOTE_CATALOG_DIR="/mnt/storage/photos/catalog/"
REMOTE_MAC_BACKUP_DIR="/mnt/storage/photos/archive/mac-removed"
EXCLUDE_FILE="$(dirname "$0")/restic-excludes.txt"

RSYNC_BIN="/opt/homebrew/bin/rsync"
[ -x "$RSYNC_BIN" ] || RSYNC_BIN="rsync"

# --- ARGS ---
DRY_RUN=()
CHECKSUM_OPT=()
SUBDIRS=()
USAGE="usage: $(basename "$0") [--dry-run] [--checksum] [SUBDIR...]"
while [ $# -gt 0 ]; do
    case "$1" in
        -n|--dry-run) DRY_RUN=(--dry-run) ;;
        --checksum) CHECKSUM_OPT=(--checksum) ;;
        -h|--help) echo "$USAGE"; exit 0 ;;
        -*) echo "$(basename "$0"): unknown argument '$1'" >&2
            echo "$USAGE" >&2
            exit 2 ;;
        *) SUBDIRS+=("$1") ;;
    esac
    shift
done

LOG_DIR="$HOME/Library/Logs/rsync-photos"
mkdir -p "$LOG_DIR"
TS="$(date +%Y%m%d-%H%M%S)"

# mac/ and catalog/ under /mnt/storage/photos are true 1:1 mirrors of the
# drive and the Lightroom catalog respectively -- everything else on the NAS
# (archive/) is curated by hand and this script never touches it.
#
# --iconv=utf-8-mac,utf-8: macOS/APFS stores umlaut filenames in NFD; the NAS
# side is NFC. Without this, rsync treats every visually-identical umlaut
# folder as brand new and re-uploads it as a duplicate instead of recognizing
# it already exists (confirmed live against the "Eivör" folder).
#
# --checksum (opt-in via --checksum flag, not on by default): needed once to
# correct mtime drift left over from the old Windows-based sync -- rsync
# updates a file's mtime (via -t) to match the source even when it skips
# re-transferring identical content, so a single --checksum run fixes every
# mismatched mtime as a side effect. After that, the default quick check
# (size+mtime, pure stat() -- no file content read at all) is both accurate
# and vastly faster, so it's the default. Pass --checksum again for occasional
# full re-verification; --checksum reads content locally on each end (no
# extra network cost beyond real diffs) but is I/O-bound and slow over a
# multi-TB library -- expected, and only worth paying for when you actually
# want that guarantee.
#
# --delete: safe here specifically because mac/ and catalog/ are true 1:1
# mirrors (drive/catalog are authoritative). Never add --delete against
# archive/.
#
# -e "ssh -o ServerAliveInterval=30 -o ServerAliveCountMax=3": without this,
# a dropped connection (network blip, sleep/wake) leaves rsync blocked on a
# read/write that will never complete -- it can hang for hours with no
# indication anything is wrong (observed live). This makes ssh notice a dead
# connection within ~90s and exit instead.
#
# REMOVED --fuzzy/--compare-dest (tried, then reverted): the idea was to
# avoid re-uploading content that already exists elsewhere on the NAS by
# letting rsync's delta-transfer use a same-size/similarly-named file
# elsewhere as a "basis" to diff against. Dropped after a crash that first
# looked like it was caused by this ("rsync: [receiver] lseek returned X,
# not Y: Invalid argument (22)", 2026-09-05/06, Photos/2026 push) -- see
# below, that turned out to have a different root cause, but --fuzzy is
# still not worth the added surface area for a bandwidth optimization
# bin/track_photo_moves already solves more safely via exact inode identity.
#
# REMOVED --partial/--partial-dir (also tried, also reverted) -- this was
# the ACTUAL cause of the crash above, confirmed by reproducing it twice
# identically (same file, same byte offsets) even after removing
# --fuzzy/--compare-dest, then fixing it by deleting the stale partial file
# and re-running fresh, which worked instantly. Resuming FROM a partial file
# reliably re-triggers "lseek returned X, not Y: Invalid argument" on this
# pairing of rsync versions (local 3.5.0, TrueNAS's 3.2.7) -- likely a
# protocol-level disagreement about how to validate/resume partial data
# across that version gap. Since resuming is what's broken, not transferring
# itself, keeping --partial-dir means every future interruption sets up the
# identical crash on the next run. Not using --partial at all means an
# interrupted large file just restarts from zero next time -- a bandwidth
# cost, but nothing compared to a script that reliably breaks itself. This
# also sidesteps the original motivation for --partial-dir in the first
# place (incomplete data landing in archive/mac-removed/ via --backup-dir on
# the next overwrite): with nothing partial ever kept, there's nothing for
# --backup-dir to sweep up.
COMMON_OPTS=(-rlt --iconv=utf-8-mac,utf-8 --delete --max-delete=1000
             -e "ssh -o ServerAliveInterval=30 -o ServerAliveCountMax=3"
             --exclude-from="$EXCLUDE_FILE" --progress "${DRY_RUN[@]}" "${CHECKSUM_OPT[@]}")

# mac/ leg only: --backup-dir moves anything the mirror would otherwise
# remove or overwrite into archive/mac-removed/ instead -- nothing this
# script touches on the mac/ leg is ever truly deleted (user: "that way i
# cannot delete something by accident"). Must be an absolute path -- a
# relative one resolves relative to the destination dir (i.e. inside mac/
# itself), which is wrong. If the same relative path is displaced again on a
# later run, the previous backup there is overwritten (only the
# most-recently-displaced version survives) -- by design, per user.
# catalog/ leg intentionally does NOT get this: the Lightroom catalog churns
# constantly with its own temp/preview files, and archiving every internal
# change would just be noise -- user's call to keep it a strict mirror.
MAC_OPTS=("${COMMON_OPTS[@]}" --backup --backup-dir="$REMOTE_MAC_BACKUP_DIR")
CATALOG_OPTS=("${COMMON_OPTS[@]}")

# Refuse to run a --delete-enabled push against a source that looks empty or
# barely populated -- guards against a failed/partial mount silently wiping
# the NAS mirror. Real libraries have thousands of entries; this threshold is
# deliberately far below that.
MIN_ENTRIES=20

check_not_suspiciously_empty() {
    local path="$1" label="$2" min="${3:-$MIN_ENTRIES}"
    local count
    count=$(find "$path" -mindepth 1 -maxdepth 2 2>/dev/null | wc -l | tr -d ' ')
    if [ "$count" -lt "$min" ]; then
        echo "!!! $label has only $count entries (need >= $min) -- refusing to run a --delete push (looks unmounted/empty)." >&2
        return 1
    fi
    return 0
}

# One or more subdir arguments means the caller is manually resuming an
# interrupted --checksum pass on just the remaining subtrees (see comment on
# --checksum above -- rsync's checksum comparison has no resume mechanism of
# its own, so this is the escape hatch), possibly several in one go (e.g.
# `Photos/2024 Photos/2025 Photos/2026`) instead of one invocation per year.
# It only makes sense for the mac/ leg. The full MIN_ENTRIES threshold is
# relaxed to just "at least 1 entry" here rather than skipped outright -- a
# small dated-event folder legitimately might not clear MIN_ENTRIES, but a
# --delete-enabled push against a truly empty/missing path (typo, partial
# mount) should still be refused, same as the unscoped legs below. Each
# subdir is independent: one failing or not being found doesn't stop the
# rest from being attempted.
if [ ${#SUBDIRS[@]} -gt 0 ]; then
    FAILED=()
    for SUBDIR in "${SUBDIRS[@]}"; do
        SAFE_NAME="${SUBDIR//\//_}"
        echo "--- Scoped push: external drive ($SUBDIR) -> mac/$SUBDIR ---"
        if [ ! -d "$PHOTO_MOUNT/$SUBDIR" ]; then
            echo "ERROR: '$PHOTO_MOUNT/$SUBDIR' not found -- skipping." >&2
            FAILED+=("$SUBDIR")
        elif ! check_not_suspiciously_empty "$PHOTO_MOUNT/$SUBDIR" "$PHOTO_MOUNT/$SUBDIR" 1; then
            FAILED+=("$SUBDIR")
        else
            LOG="$LOG_DIR/mac-$TS-$SAFE_NAME.log"
            "$RSYNC_BIN" "${MAC_OPTS[@]}" "$PHOTO_MOUNT/$SUBDIR/" "${REMOTE_HOST}:${REMOTE_MAC_DIR}${SUBDIR}" 2>&1 | tee "$LOG"
            MAC_RC=$?
            if [ "$MAC_RC" -ne 0 ]; then
                echo "!!! mac/$SUBDIR push exited with status $MAC_RC -- see $LOG" >&2
                FAILED+=("$SUBDIR")
            fi
        fi
        echo ""
    done
    echo "--- Scoped run finished (catalog/ leg skipped) ---"
    if [ ${#FAILED[@]} -gt 0 ]; then
        echo "!!! ${#FAILED[@]} of ${#SUBDIRS[@]} subdir(s) failed or were not found: ${FAILED[*]}" >&2
        exit 1
    fi
    exit 0
fi

echo "--- [1/2] Pushing external drive -> mac/ ---"
if [ -d "$PHOTO_MOUNT" ]; then
    if check_not_suspiciously_empty "$PHOTO_MOUNT" "$PHOTO_MOUNT"; then
        LOG="$LOG_DIR/mac-$TS.log"
        "$RSYNC_BIN" "${MAC_OPTS[@]}" "$PHOTO_MOUNT/" "${REMOTE_HOST}:${REMOTE_MAC_DIR}" 2>&1 | tee "$LOG"
        MAC_RC=$?
        [ "$MAC_RC" -ne 0 ] && echo "!!! mac/ push exited with status $MAC_RC -- see $LOG" >&2
    fi
else
    echo "INFO: external drive ($PHOTO_MOUNT) not attached -- skipping."
fi

echo ""
echo "--- [2/2] Pushing Lightroom catalog -> catalog/ ---"
if [ -d "$CATALOG_SRC" ]; then
    if check_not_suspiciously_empty "$CATALOG_SRC" "$CATALOG_SRC"; then
        LOG="$LOG_DIR/catalog-$TS.log"
        "$RSYNC_BIN" "${CATALOG_OPTS[@]}" "$CATALOG_SRC/" "${REMOTE_HOST}:${REMOTE_CATALOG_DIR}" 2>&1 | tee "$LOG"
        CAT_RC=$?
        [ "$CAT_RC" -ne 0 ] && echo "!!! catalog/ push exited with status $CAT_RC -- see $LOG" >&2
    fi
else
    echo "ERROR: catalog path '$CATALOG_SRC' not found!" >&2
fi

echo ""
echo "--- Push run finished ---"
